# Port
PORT=8000

# Environment Gating
NODE_ENV=production
APP_ENV=production

# Database Connection
MONGODB_URL=mongodb://localhost:27017/smartface
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname

# JWT / Cryptographic Configuration
SECRET_KEY=your_super_secret_jwt_key
JWT_SECRET=your_super_secret_jwt_key
JWT_REFRESH_SECRET=your_unused_but_requested_refresh_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Email (AttendAI Official SMTP Mailer)
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_google_app_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# AI & Third-Party APIs
GROQ_API_KEY=your_groq_api_key
GOOGLE_API_KEY=your_google_api_key
FACE_SCANNER_TOKEN=secure_face_scanner_default_key_123

# Client & CORS Configuration
CLIENT_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://api.smartface.pro
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://api.smartface.pro

# Google Sheets Configuration
# GSHEETS_URL=https://docs.google.com/spreadsheets/d/...
