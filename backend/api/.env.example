# Port
PORT=8000

# Environment Gating
NODE_ENV=production
APP_ENV=production

# Database Connection
MONGODB_URL=mongodb://localhost:27017/smartface
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname

# JWT / Cryptographic Configuration
SECRET_KEY=your_super_secret_jwt_key
JWT_SECRET=your_super_secret_jwt_key
JWT_REFRESH_SECRET=your_unused_but_requested_refresh_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Email — Resend HTTP API Configuration
EMAIL_PROVIDER=resend
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=Smart Attendance AI <noreply@smartface.pro>
EMAIL_FROM=noreply@smartface.pro
EMAIL_SENDER_NAME=Smart Attendance AI

# Email — Brevo (Sendinblue) HTTP API (Fallback)
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM_ADDRESS=your_email@gmail.com
EMAIL_FROM_NAME=your_sender_name

# AI & Third-Party APIs
GROQ_API_KEY=your_groq_api_key
GOOGLE_API_KEY=your_google_api_key
FACE_SCANNER_TOKEN=secure_face_scanner_default_key_123
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TOKEN=secure_internal_ai_token_key_789
AI_SERVICE_TIMEOUT_MS=18000

# College DB API (https://collegedb.in)
COLLEGEDB_API_KEY=your_collegedb_api_key
COLLEGEDB_BASE_URL=https://api.collegedb.in

# Client & CORS Configuration
CLIENT_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://api.smartface.pro
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://api.smartface.pro

# Google Sheets Configuration
# GSHEETS_URL=https://docs.google.com/spreadsheets/d/...

