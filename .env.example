# ======================================================================
# SMARTFACE AI PLATFORM — CONSOLIDATED PRODUCTION ENVIRONMENT TEMPLATE
# ======================================================================

# ----------------------------------------------------------------------
# 1. NODE.JS EXPRESS BACKEND SERVICES (smartface_node_api)
# ----------------------------------------------------------------------
# Port the node API will run on in the server
PORT=8000
NODE_ENV=production
APP_ENV=production

# MongoDB production database connection URL
MONGODB_URL=mongodb+srv://<db_user>:<db_password>@cluster.mongodb.net/smartface?retryWrites=true&w=majority
MONGODB_ATLAS_PUBLIC_KEY=your_mongodb_atlas_public_key
MONGODB_ATLAS_PRIVATE_KEY=your_mongodb_atlas_private_key
MONGODB_PUBLIC_KEY=your_mongodb_atlas_public_key
MONGODB_PRIVATE_KEY=your_mongodb_atlas_private_key

# Cryptographic token signing secret key (minimum 64-char random hash suggested)
SECRET_KEY=your_production_secure_jwt_secret_key_minimum_64_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# White-listed CORS origin domains for frontend security (comma-separated, no wildcard in production)
CORS_ORIGINS=https://smartface.pro,https://dashboard.smartface.pro

# Official SMTP Mailer settings
EMAIL_USER=notifications@smartface.pro
EMAIL_PASSWORD=your_secure_smtp_app_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Face Scanner integration key to verify hardware reader calls
FACE_SCANNER_TOKEN=secure_face_scanner_production_token_secret_123

# Google Maps/Geocoding services API key
GOOGLE_API_KEY=AIzaSyProductionGoogleMapsApiKeyHere

# LLM Analytics (Groq Cloud API Key)
GROQ_API_KEY=gsk_production_groq_cloud_api_key_here

# ----------------------------------------------------------------------
# 2. PYTHON FASTAPI FACE RECOGNITION SERVICE (smartface_pro_api)
# ----------------------------------------------------------------------
# Fast API server port (default 8000 or custom)
FASTAPI_PORT=8000

# ----------------------------------------------------------------------
# 3. NEXT.JS WEB PORTAL (smartface_landing_web)
# ----------------------------------------------------------------------
# Base URL pointing to the Node Express Gateway API for client requests
NEXT_PUBLIC_API_URL=https://api.smartface.pro

# ----------------------------------------------------------------------
# 4. FLUTTER MOBILE CLIENT (smartface_mobile)
# ----------------------------------------------------------------------
# Mobile endpoints pointing to the production server gateway
API_URL=https://api.smartface.pro
WS_URL=wss://api.smartface.pro

# Firebase credentials for Push Notifications (FCM)
FIREBASE_API_KEY=AIzaSyProductionFirebaseApiKey
FIREBASE_APP_ID=1:1234567890:android:production
FIREBASE_MESSAGING_SENDER_ID=1234567890
FIREBASE_PROJECT_ID=smartface-production
FIREBASE_STORAGE_BUCKET=smartface-production.appspot.com

# ----------------------------------------------------------------------
# 5. OAUTH CONFIGURATIONS
# ----------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_production_google_client_id_here
GITHUB_CLIENT_ID=your_production_github_client_id_here
GITHUB_CLIENT_SECRET=your_production_github_client_secret_here

