# Public base URL of the marketing site (used by robots.txt + sitemap.xml).
NEXT_PUBLIC_SITE_URL=https://smartface.pro

# Public base URL of Website 2 (the unified portal app).
# Used for every role link: /student, /teacher, /admin, /parent.
# Safe to expose to the browser — it is a public URL, never a secret.
NEXT_PUBLIC_PORTAL_URL=https://portal.smartface.pro

# Plausible / self-hosted analytics domain. Leave empty to disable the snippet.
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# Turnstile site key for the demo-request form (public, safe in the browser).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
