# Server Configuration
PORT=8001
NODE_ENV=production
PROJECT_ROOT=

# Security & Secret Tokens
AI_INTERNAL_TOKEN=your_strong_secret_internal_token_here
FACE_SCANNER_TOKEN=secure_face_scanner_default_key_123

# Face Inference Limits & Bounds
MAX_IMAGE_SIZE_MB=5
FACE_INFERENCE_TIMEOUT_SECONDS=15
FACE_INFERENCE_CONCURRENCY=2
ENABLE_FACE_TRAINING=false

# Database Configuration
MONGODB_URL=mongodb+srv://user:password@cluster.mongodb.net/smartface?retryWrites=true&w=majority
GROQ_API_KEY=your_groq_api_key
